{
    "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
    "id": "modpack-switcher",
    "name": "Modpack Switcher",
    "version": "1.0.0",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": ">=2.0.0-beta.6 <3.0",
        "php": "^8.3"
    },
    "description": "Browse and install Minecraft modpacks on your server.",
    "provider": "ModpackSwitcher\\ModpackSwitcherProvider",
    "ui": {
        "entry": "dist/client.js",
        "mode": "native",
        "prefix": "ms",
        "screens": [
            {
                "id": "main",
                "area": "server",
                "path": "modpack-switcher",
                "nav": {
                    "label": "Modpack Switcher"
                }
            }
        ]
    },
    "author": "Dasky"
}
